{
  "folders": [
    {
      "path": ".",
      "name": "FTN Docs Site"
    },
    {
      "path": "../food-truck-api/docs",
      "name": "food-truck-api docs"
    },
    {
      "path": "../ftn-site/docs",
      "name": "ftn-site docs"
    },
    {
      "path": "../ftn-site-old/docs",
      "name": "ftn-site-old docs"
    },
    {
      "path": "../onboarding/docs",
      "name": "onboarding docs"
    },
    {
      "path": "../help/docs",
      "name": "help docs"
    },
    {
      "path": "../developer-portal/docs",
      "name": "developer-portal docs"
    }
  ],
  "extensions": {
    "recommendations": [
      // Code Formatters & Linters
      "dprint.dprint",
      "biomejs.biome",

      // Markup & Documentation
      "asciidoctor.asciidoctor-vscode",
      "DavidAnson.vscode-markdownlint",
      "yzhang.markdown-all-in-one",
      "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
      "bierner.markdown-mermaid",
      "redhat.vscode-yaml",
      "tamasfe.even-better-toml",

      // Web Technologies
      "astro-build.astro-vscode",
      "unifiedjs.vscode-mdx",

      // Git & Collaboration
      "eamodio.gitlens"
    ]
  },
  "settings": {
    // Hidden from view in VS Code
    "files.exclude": {
      "**/node_modules": true,
      "**/.git": true,
      "**/.next": true
    },

    // Hidden from search to improve performance in VS Code
    "search.exclude": {
      "**/node_modules": true,
      "**/.git": true,
      "**/.next": true
    },

    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    // We use dprint as our default formatter
    "editor.defaultFormatter": "dprint.dprint",

    /// Language settings
    "[asciidoc]": {
      "editor.wordWrap": "on",
      "editor.defaultFormatter": "asciidoctor.asciidoctor-vscode"
    },
    "[markdown]": {
      "editor.defaultFormatter": "dprint.dprint",
      "editor.wordWrap": "on"
    },
    "[javascript]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[typescript]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[json]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[code-workspace]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[css]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[graphql]": {
      "editor.defaultFormatter": "dprint.dprint"
    },
    "[yaml]": {
      "editor.defaultFormatter": "dprint.dprint"
    },

    "markdownlint.config": {
      "MD033": false // Allow HTML in markdown files
    },

    "scm.alwaysShowRepositories": true,
    "scm.providerCountBadge": "auto",
    "git.closeDiffOnOperation": true,
    "git.autoRepositoryDetection": false,
    "git.scanRepositories": [
      ".",
      "../food-truck-api",
      "../ftn-site",
      "../ftn-site-old",
      "../onboarding",
      "../help",
      "../developer-portal"
    ],

    "yaml.schemas": {
      "https://json.schemastore.org/github-funding.json": "/.github/FUNDING.yml"
    },

    // Change merge editor colors to not be so jarring
    "workbench.colorCustomizations": {
      "mergeEditor.conflict.unhandledFocused.border": "#00945b",
      "mergeEditor.conflict.unhandledUnfocused.border": "#00784a"
    },

    "powershell.cwd": "Antora Docs Site"
  }
}
