# Allow-list gitignore: everything is ignored unless explicitly un-ignored.
# When adding a new root file or directory, add a `!` entry here.

*
!*/

# Tracked root files and directories
!/.antora-source-id
!/.editorconfig
!/.gitattributes
!/.github/**
!/.gitignore
!/.hintrc
!/.vscode/**
!/antora-playbook.yml
!/biome.json
!/docs/**
# Members-only docs (built by team-docs, not the public hub)
!/docs-internal/**
!/dprint.jsonc
!/ftn-docs.code-workspace
!/notes/**
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/README.adoc
!/scripts/**
!/site/**

# Re-ignore generated and local files inside allowed directories
node_modules/
.pnpm-store/
build/
site/build/
site/node_modules/
site/package.json
site/pnpm-lock.yaml
site/package-lock.json
antora-playbook-local.yml
antora-playbook-local-*.yml
!antora-playbook-local*.example.yml
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
