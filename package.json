{
  "devDependencies": {
    "@antora-supplemental/facto-stack": "github:antora-supplemental/facto-stack#main",
    "@asciidoctor/core": "^3.0.4",
    "@dev-centr/mermaid-svg-css-vars": "0.1.3",
    "@dev-centr/themed-svg": "0.2.3",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "antora": "^3.1.14",
    "puppeteer": "25.12.0"
  },
  "scripts": {
    "build": "pnpm diagrams:check && antora --fetch antora-playbook.yml",
    "build:local": "pnpm diagrams:check && antora --fetch antora-playbook-local.yml",
    "diagrams": "node scripts/build-diagrams.mjs",
    "diagrams:check": "node scripts/build-diagrams.mjs --check"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ],
    "publicHoistPattern": [
      "@antora/lunr-extension",
      "@antora-supplemental/page-edit",
      "@antora-supplemental/build-stack",
      "@antora-supplemental/unversioned-component-urls",
      "@antora-supplemental/asciidoctor-emoji-literals",
      "asciidoctor-emoji"
    ],
    "overrides": {
      "inflight": "npm:lru-cache@^10.0.0",
      "glob": "^10.0.0",
      "punycode": "^2.3.1"
    }
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4"
  }
}
