{
  "folders": [
    {
      "path": ".",
      "name": "FTN Docs",
    },
    {
      "path": "../food-truck-api/docs",
      "name": "food-truck-api docs",
    },
    {
      "path": "../ftn-site-vercel/docs",
      "name": "ftn-site-vercel docs",
    },
    {
      "path": "../FoodTruckNerdzSite/docs",
      "name": "FoodTruckNerdzSite docs",
    },
    {
      "path": "../onboarding/docs",
      "name": "onboarding docs",
    },
    {
      "path": "../help/docs",
      "name": "help docs",
    },
    {
      "path": "../developer-portal/docs",
      "name": "developer-portal docs",
    },
  ],

  "extensions": {
    "recommendations": [
      // Documentation (Asciidoc & Markdown)
      "asciidoctor.asciidoctor-vscode",
      "bpruitt-goddard.mermaid-markdown-syntax-highlighting",
      "bierner.markdown-mermaid",

      // Core Formatters
      "esbenp.prettier-vscode",
      "biomejs.biome",
    ],
  },

  "settings": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,

    "[markdown]": {
      "editor.wordWrap": "on",
    },

    "[asciidoc]": {
      "editor.formatOnSave": true,
    },

    "markdownlint.config": {
      "MD033": false,
    },

    // Git: scan parent repos so Source Control panel can commit to each
    "git.autoRepositoryDetection": false,
    "git.scanRepositories": [
      ".",
      "../food-truck-api",
      "../ftn-site-vercel",
      "../FoodTruckNerdzSite",
      "../onboarding",
      "../help",
      "../developer-portal",
    ],

    "powershell.cwd": "Antora Docs Site",
  },
}
