flowchart LR
  dev["Developer"] -->|push to main| repo["GitHub repository"]
  repo -->|trigger workflow| runner["GitHub Actions runner"]
  runner --> checkout["Checkout and install dependencies"]
  checkout -->|GIT_CREDENTIALS| private["Private content repositories"]
  private -->|content sources| build["Build Antora site"]
  build --> pages["GitHub Pages"]
  pages -->|site available| dev
  class dev primary
  class repo,runner,checkout accent
  class private secondary
  class build warning
  class pages success

  classDef primary fill:#ffffff,stroke:#52606d,color:#172033
