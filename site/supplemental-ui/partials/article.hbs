<article class="doc">
{{#with page.title}}
<div class="ftn-page-header">
  <h1 class="page ftn-page-title">{{{this}}}</h1>
  <div class="ftn-page-header-edit">{{> edit-this-page}}</div>
</div>
{{else}}
<div class="ftn-page-header ftn-page-header--no-title">{{> edit-this-page}}</div>
{{/with}}
{{{page.contents}}}
{{> pagination}}
</article>
