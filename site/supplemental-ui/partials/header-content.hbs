<header class="header ftn-header">
  <nav class="navbar ftn-site-navbar" aria-label="Site">
    <div class="navbar-brand ftn-header-brand">
      <a class="ftn-header-logo-item" href="{{{or (lookup site.keys 'foodtrucknerdz_com') 'https://foodtrucknerdz.com'}}}" rel="noopener" target="_blank" title="foodtrucknerdz.com" aria-label="foodtrucknerdz.com — open in new tab">
        <img class="ftn-header-logo" src="{{{uiRootPath}}}/img/foodtrucknerdz.svg" width="34" height="34" alt="" />
      </a>
      <a class="navbar-item ftn-header-title" href="{{{or site.url siteRootPath}}}">Documentation</a>
    </div>
    <div id="topbar-nav" class="navbar-menu ftn-topbar" role="navigation" aria-label="External links">
      <div class="navbar-end ftn-header-actions">
        {{#if (and @root.page.origin @root.page.origin.webUrl)}}
        <a class="navbar-item ftn-header-icon-btn ftn-header-vcs" href="{{{@root.page.origin.webUrl}}}" rel="noopener" target="_blank" title="Source repository" aria-label="Source repository (opens in new tab)">
          <img class="ftn-header-vcs-img" src="{{{uiRootPath}}}/img/vcs/code.svg" width="24" height="24" alt="" />
        </a>
        {{else}}
        <a class="navbar-item ftn-header-icon-btn ftn-header-vcs" href="{{{or (lookup site.keys 'github_profile_url') 'https://github.com/FoodTruckNerdz'}}}" rel="noopener" target="_blank" title="Project on GitHub" aria-label="Project on GitHub (opens in new tab)">
          <img class="ftn-header-vcs-img" src="{{{uiRootPath}}}/img/vcs/github.svg" width="24" height="24" alt="" />
        </a>
        {{/if}}
      </div>
    </div>
  </nav>
  {{> ftn-doc-mast}}
</header>
